 "memo": {
  "memo": {
   "headline": "Poor-enrollment stops in comparable trials at 9.8% are the biggest recruitment risk [F13]",
   "evidence_limits": "The comparable set is 112 trials and the stop-rate interval is wide at 5.6% to 16.7%, so the estimate is imprecise [F13]. The pace is a floor because the registry span includes follow-up and the protocol states no enrollment period [F5, F22].",
   "bottlenecks": [
    {
     "title": "Comparable trials stopped for poor enrollment",
     "evidence": "Comparable trials had 11 poor-enrollment stops from 112 trials, at 9.8% (95% CI 5.6% to 16.7%), compared with 4.2% in the full pool and 2.35 times the pool rate [F13, F14, F15]. Examples include NCT00366106 and NCT00718640, both recorded with slow or lagging enrolment [F13].",
     "what_to_check": "Before sign-off, check why comparable trials such as NCT00366106 stopped and whether the draft plan addresses those site and timing issues.",
     "facts": [
      "F13",
      "F14",
      "F15"
     ],
     "trials": [
      "NCT00366106",
      "NCT00718640"
     ]
    },
    {
     "title": "Site count mismatch raises needed pace",
     "evidence": "The protocol says 20 sites, while the Jan 2017 registry record lists 5 sites [F4, F21]. With 20 sites the needed pace is 0.10 participants per site per month, but with 5 sites it is 0.40 and 42.8% of completed comparables were at least that fast [F16, F19].",
     "what_to_check": "Confirm the funded and contracted site count before sign-off and use the confirmed count in the enrollment plan.",
     "facts": [
      "F4",
      "F16",
      "F19",
      "F21"
     ],
     "trials": []
    },
    {
     "title": "Enrollment period is unstated and pace is a floor",
     "evidence": "The protocol states no enrollment period [F5]. The pace uses 56 months from registry start to planned primary completion, which includes follow-up, so the pace shown is a floor [F16, F22].",
     "what_to_check": "Add a stated enrollment period to the protocol and recheck the needed pace against that period before sign-off.",
     "facts": [
      "F5",
      "F16",
      "F22"
     ],
     "trials": []
    },
    {
     "title": "Many competing United States trials",
     "evidence": "On Jan 5, 2017 there were 98 competing trials for multiple myeloma, Phase 2, in the United States, at 1,523 sites in total [F12, F20]. Large competing programmes included NCT02654990 at 39 sites and NCT02951819 at 32 sites [F20].",
     "what_to_check": "Check site overlap with NCT02654990 and NCT02951819 and consider country or site changes before sign-off.",
     "facts": [
      "F12",
      "F20"
     ],
     "trials": [
      "NCT02654990",
      "NCT02951819"
     ]
    },
    {
     "title": "Narrow entry wording and visit load",
     "evidence": "Eligibility as read covers age 18 to 74, ECOG performance status ≤ 2, newly diagnosed disease, and no prior anti-myeloma chemotherapy or medication [F1, F7]. The visit count is 24 clinic visits in the first 26 weeks, with 0 remote visits and an inpatient stay required, which may add a modest burden [F8, F9].",
     "what_to_check": "Recheck the age, prior therapy, and performance status wording and the visit schedule wording before sign-off.",
     "facts": [
