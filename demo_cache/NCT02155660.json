 "memo": {
  "memo": {
   "headline": "Competition, an unstated enrollment period, and site-count mismatch are the main recruitment risks to resolve before sign-off.",
   "evidence_limits": "The comparable evidence is thin for poor-enrollment stops: 1 of 303 trials stopped for poor enrollment, at 0.3% with a 95% CI of 0.1% to 1.8%, shown for NCT00493974 [F12]. The pace is a floor because it includes follow-up, so this evidence cannot show the true enrollment pace or site-level performance [F21].",
   "bottlenecks": [
    {
     "title": "Heavy competition for same patients",
     "evidence": "42 competing Phase 3 COPD trials were recruiting on Jan 5, 2017, at 1,143 sites in total [F11, F19]. The largest was NCT02138916, a benralizumab COPD trial at 427 sites, with NCT02465567 at 103 sites and NCT02497001 at 94 sites also listed [F19].",
     "what_to_check": "Check overlap in countries, sites, and timing with NCT02138916 and the other listed competing programmes before sign-off.",
     "facts": [
      "F11",
      "F19"
     ],
     "trials": [
      "NCT02138916",
      "NCT02465567",
      "NCT02497001"
     ]
    },
    {
     "title": "Enrollment period and pace unclear",
     "evidence": "The protocol states no enrollment period, so the pace uses the registry start to planned primary completion span and is a floor [F5, F21]. The needed pace is 0.12 participants per site per month over 47 months [F15].",
     "what_to_check": "State a separate enrollment period in the protocol and re-check the pace against that period before sign-off.",
     "facts": [
      "F5",
      "F15",
      "F21"
     ],
     "trials": []
    },
    {
     "title": "Site count does not match",
     "evidence": "The protocol says 380 sites, while the Jan 2017 registry record lists 362 sites [F4, F20]. With 362 sites the needed pace is 0.13 participants per site per month [F18].",
     "what_to_check": "Confirm which site count is correct and that site activation plans match the confirmed count.",
     "facts": [
      "F4",
      "F18",
      "F20"
     ],
     "trials": []
    },
    {
     "title": "Large, wide delivery footprint",
     "evidence": "Planned enrollment is 2,168 participants across 4 arms [F1, F3]. The registry lists 26 countries, which adds start-up and coordination load across many site networks [F4, F6].",
     "what_to_check": "Check country and site allocation, activation order, and backup sites for countries that start late.",
     "facts": [
      "F1",
      "F3",
      "F4",
      "F6"
     ],
     "trials": []
    },
    {
     "title": "Eligibility wording may narrow pool",
     "evidence": "The draft covers moderate to very severe COPD with history of COPD exacerbations, with age 40 to 85 as read [F1, F7]. The longest washout as read is 180 days [F7].",
     "what_to_check": "Check eligibility and washout wording against site screening logs from past COPD trials before sign-off.",
     "facts": [
      "F1",
      "F7"
     ],
     "trials": []
    }
   ]
