  "memo": {
   "headline": "Biggest risk is competition: 30 Phase 3 Alzheimer trials were recruiting at 2,014 sites in January 2017 [F19]",
   "evidence_limits": "The comparable set is small at 44 trials, with a poor-enrollment stop rate of 0.0% and a wide interval of 0.0% to 8.0%, so it cannot rule out enrollment risk [F13]. The needed pace is a floor, and the pack does not show biomarker screening yield, site overlap, or site start-up timing [F20, F7, F19].",
   "bottlenecks": [
    {
     "title": "Competition for the same patients",
     "evidence": "30 Phase 3 Alzheimer trials were recruiting on Jan 5, 2017, at 2,014 sites in total [F19, F12]. Large competing programmes included NCT02670083 at 233 sites and NCT02477800 at 177 sites [F19]. This is indirect evidence, as the pack does not show site overlap for this protocol [F19].",
     "what_to_check": "Before sign-off, map the planned sites against NCT02670083, NCT02477800, and NCT02484547 and check which sites are committed to competing programmes.",
     "facts": [
      "F19",
      "F12"
     ],
     "trials": [
      "NCT02670083",
      "NCT02477800",
      "NCT02484547",
      "NCT02783573",
      "NCT02585934"
     ]
    },
    {
     "title": "Biomarker-required eligibility narrowing",
     "evidence": "Eligibility requires age 55 to 85 and a florbetapir PET scan or CSF result consistent with amyloid pathology [F7]. The longest washout read from the protocol is 120 days [F7]. The pack gives no screening or biomarker failure counts, so the size of this effect cannot be shown here [F7].",
     "what_to_check": "Before sign-off, check the eligibility wording and confirm site capacity for PET and CSF pathways within the planned countries.",
     "facts": [
      "F7"
     ],
     "trials": []
    },
    {
     "title": "Site and timeframe not stated",
     "evidence": "The protocol plans 2,450 participants, but it does not state sites or the enrollment period [F3, F4, F5]. The registry record lists 240 sites, and the computed pace of 0.18 participants per site per month uses 58 months from start to planned primary completion [F4, F16]. That pace is a floor because the span includes follow-up [F20].",
